# Copia este archivo a .env y reemplaza los valores. Nunca subas el .env real.

# Backend
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST/BASE?sslmode=require
SECRET_KEY=cambia-esta-clave
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_URL=http://localhost:5173

# IA opcional (explicación del riesgo con Gemini). Sin clave, la aplicación usa solo reglas.
# Crea la clave en https://aistudio.google.com/app/api-keys y nunca la subas al repositorio.
GEMINI_API_KEY=
# Debe ser un modelo disponible para tu clave; revisa la lista en AI Studio.
GEMINI_MODEL=gemini-3.5-flash-lite

# Solo para python -m app.seed: contraseña de los 3 usuarios de demostración (inventa una)
SEED_PASSWORD=cambia-esta-clave-demo

# Frontend (no pongas claves aquí: estas variables quedan visibles en el navegador)
VITE_API_URL=http://localhost:8000
